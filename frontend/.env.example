# Las variables de Vite deben empezar con VITE_

# URL del backend (sin /api al final)
VITE_API_URL=http://localhost:3000

# SOLO PARA LA SIMULACIÓN de Mercado Pago: tiene que ser igual a WEBHOOK_SECRET del .env del backend.
# Con Mercado Pago real este valor NO va en el frontend (lo manda Mercado Pago al backend).
VITE_WEBHOOK_SECRET=webhook_prueba
